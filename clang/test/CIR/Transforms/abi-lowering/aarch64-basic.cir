// RUN: cir-opt %s -cir-call-conv-lowering=target=aarch64 | FileCheck %s

// AAPCS64 classification of aggregates under target=aarch64, with no
// cir.triple on the module: a struct past 16 bytes is returned through sret
// and passed by reference, a homogeneous floating-point aggregate is passed as
// an array of its members, and a struct up to 16 bytes goes in integer
// registers.

!s64i = !cir.int<s, 64>
!rec_Big = !cir.struct<"Big" {data !s64i, data !s64i, data !s64i, data !s64i}>
!rec_HFA4 = !cir.struct<"HFA4" {data !cir.float, data !cir.float, data !cir.float, data !cir.float}>
!rec_Pair16 = !cir.struct<"Pair16" {data !s64i, data !s64i}>

module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<i32, dense<32>: vector<2xi64>>,
    #dlti.dl_entry<i64, dense<64>: vector<2xi64>>>
} {

  cir.func private @ret_big(!s64i) -> !rec_Big requires_call_conv_lowering
  // CHECK: cir.func private @ret_big(!cir.ptr<!rec_Big> {{.*}}llvm.sret = !rec_Big{{.*}}, !s64i)

  cir.func private @take_big(!rec_Big) -> !s64i requires_call_conv_lowering
  // CHECK: cir.func private @take_big(!cir.ptr<!rec_Big> {{.*}}llvm.dereferenceable = 32 : i64{{.*}}) -> !s64i

  cir.func private @take_hfa4(!rec_HFA4) -> !s64i requires_call_conv_lowering
  // CHECK: cir.func private @take_hfa4(!cir.array<!cir.float x 4> {llvm.alignstack = 8 : i64}) -> !s64i

  cir.func private @ret_pair16(!s64i) -> !rec_Pair16 requires_call_conv_lowering
  // CHECK: cir.func private @ret_pair16(!s64i) -> !cir.array<!u64i x 2>

  cir.func private @take_pair16(!rec_Pair16) -> !s64i requires_call_conv_lowering
  // CHECK: cir.func private @take_pair16(!cir.array<!u64i x 2>) -> !s64i
}
